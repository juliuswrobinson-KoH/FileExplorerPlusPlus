<Window
    x:Class="UI.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:converters="using:UI.Converters"
    Title="Explorer++">
    <Grid x:Name="Root" Background="Transparent" IsTabStop="True">
        <Grid.Resources>
            <converters:FontFamilyConverter x:Key="FontFamilyConverter"/>
            <converters:FontColorConverter x:Key="FontColorConverter"/>
            <DataTemplate x:Key="DetailEntryTemplate">
                <Grid Padding="8,5" ColumnSpacing="10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="24"/>
                        <ColumnDefinition Width="2*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="100"/>
                        <ColumnDefinition Width="150"/>
                    </Grid.ColumnDefinitions>
                    <Grid Width="20" Height="20" VerticalAlignment="Center">
                        <FontIcon Glyph="{Binding Icon}" Foreground="#83BFFF"/>
                        <Image Source="{Binding IconImage}" Stretch="Uniform"/>
                    </Grid>
                    <TextBlock Grid.Column="1" Text="{Binding Name}" FontFamily="{Binding ItemFontFamily, Converter={StaticResource FontFamilyConverter}}" FontSize="{Binding ItemFontSize}" Foreground="{Binding ItemFontColor, Converter={StaticResource FontColorConverter}}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="2" Text="{Binding Type}" FontFamily="{Binding ItemFontFamily, Converter={StaticResource FontFamilyConverter}}" FontSize="{Binding ItemFontSize}" Foreground="#AAB4C2" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="3" Text="{Binding Size}" FontFamily="{Binding ItemFontFamily, Converter={StaticResource FontFamilyConverter}}" FontSize="{Binding ItemFontSize}" Foreground="#AAB4C2" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="4" Text="{Binding Modified}" FontFamily="{Binding ItemFontFamily, Converter={StaticResource FontFamilyConverter}}" FontSize="{Binding ItemFontSize}" Foreground="#AAB4C2" Margin="12,0,0,0" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                </Grid>
            </DataTemplate>
            <DataTemplate x:Key="ListEntryTemplate">
                <StackPanel Orientation="Horizontal" Spacing="8" Padding="6,3">
                    <Grid Width="20" Height="20">
                        <FontIcon Glyph="{Binding Icon}" Foreground="#83BFFF" FontSize="16"/>
                        <Image Source="{Binding IconImage}" Stretch="Uniform"/>
                    </Grid>
                    <TextBlock Text="{Binding Name}" FontFamily="{Binding ItemFontFamily, Converter={StaticResource FontFamilyConverter}}" FontSize="{Binding ItemFontSize}" Foreground="{Binding ItemFontColor, Converter={StaticResource FontColorConverter}}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                </StackPanel>
            </DataTemplate>
            <DataTemplate x:Key="ThumbnailEntryTemplate">
                <Grid Width="{Binding TileSize}" Height="{Binding TileSize}" Margin="5">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid Padding="4">
                        <FontIcon Glyph="{Binding Icon}" FontSize="36" Foreground="#83BFFF"
                                  HorizontalAlignment="Center" VerticalAlignment="Center"
                                  Visibility="{Binding PreviewIconVisibility}"/>
                        <Image Source="{Binding PreviewImage}" Stretch="Uniform"
                               Visibility="{Binding PreviewImageVisibility}"/>
                        <TextBlock Text="{Binding PreviewText}" FontSize="8" FontFamily="Consolas"
                                   Foreground="#DDE5EF" TextWrapping="Wrap" TextTrimming="CharacterEllipsis"
                                   Visibility="{Binding PreviewTextVisibility}"/>
                    </Grid>
                    <TextBlock Grid.Row="1" Text="{Binding Name}" FontFamily="{Binding ItemFontFamily, Converter={StaticResource FontFamilyConverter}}" FontSize="{Binding ItemFontSize}" Foreground="{Binding ItemFontColor, Converter={StaticResource FontColorConverter}}" Margin="3,4,3,0"
                               TextWrapping="Wrap" TextTrimming="CharacterEllipsis"
                               HorizontalAlignment="Center" TextAlignment="Center"/>
                    <TextBlock Grid.Row="2" Text="{Binding Size}" FontSize="9" Foreground="#AAB4C2"
                               HorizontalAlignment="Center"/>
                </Grid>
            </DataTemplate>
            <ItemsPanelTemplate x:Key="StackEntryPanel">
                <ItemsStackPanel Orientation="Vertical"/>
            </ItemsPanelTemplate>
            <ItemsPanelTemplate x:Key="WrapEntryPanel">
                <ItemsWrapGrid Orientation="Horizontal"/>
            </ItemsPanelTemplate>
        </Grid.Resources>
        <Grid.RowDefinitions>
            <RowDefinition Height="32"/>
            <RowDefinition Height="96"/>
            <RowDefinition Height="44"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="34"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="238"/>
            <ColumnDefinition Width="6"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Grid x:Name="TitleBarDragRegion" Grid.Row="0" Grid.ColumnSpan="3" Background="Transparent">
            <TextBlock Text="Explorer++" Margin="12,0,0,0" VerticalAlignment="Center"
                       FontSize="12" Foreground="#E8EDF4"/>
        </Grid>

        <Border Grid.Row="1" Grid.ColumnSpan="3" Background="Transparent"
                BorderBrush="#303640" BorderThickness="0,0,0,1">
            <Grid Padding="12,7">
                <Grid.RowDefinitions>
                    <RowDefinition Height="22"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="1"/>
                    <ColumnDefinition Width="92"/>
                </Grid.ColumnDefinitions>
                <Grid Grid.RowSpan="2" Grid.Column="0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="22"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <TextBlock Text="PHYSICAL DRIVES &amp; PARTITIONS" FontSize="10" FontWeight="Bold" Foreground="#AAB4C2"/>
                    <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                        <ItemsControl x:Name="DriveGroups" ItemsSource="{x:Bind PhysicalDrives}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal" Spacing="8"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="#20252D" BorderBrush="#343B46" BorderThickness="1" CornerRadius="5" Padding="8,4"
                                            RightTapped="DriveContext_RightTapped">
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <StackPanel VerticalAlignment="Center" Width="150">
                                                <TextBlock Text="{Binding Name}" FontSize="11" FontWeight="SemiBold"/>
                                                <TextBlock Text="{Binding Model}" FontSize="10" Foreground="#AAB4C2"
                                                           TextTrimming="CharacterEllipsis" ToolTipService.ToolTip="{Binding Model}"/>
                                                <TextBlock Text="{Binding SizeText}" FontSize="9" Foreground="#AAB4C2"/>
                                            </StackPanel>
                                            <ItemsControl ItemsSource="{Binding Partitions}">
                                                <ItemsControl.ItemsPanel>
                                                    <ItemsPanelTemplate>
                                                        <StackPanel Orientation="Horizontal" Spacing="4"/>
                                                    </ItemsPanelTemplate>
                                                </ItemsControl.ItemsPanel>
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Button Click="DrivePartition_Click" Tag="{Binding}" IsEnabled="{Binding HasPath}"
                                                                RightTapped="DriveContext_RightTapped">
                                                            <StackPanel Orientation="Horizontal" Spacing="6" MaxWidth="190">
                                                                <Grid Width="26" Height="26">
                                                                    <FontIcon Glyph="{Binding Icon}" Foreground="#83BFFF" FontSize="18"/>
                                                                    <Image Source="{Binding IconImage}" Stretch="Uniform"/>
                                                                </Grid>
                                                                <StackPanel VerticalAlignment="Center">
                                                                    <TextBlock Text="{Binding Name}" FontSize="11" FontWeight="SemiBold"
                                                                               TextTrimming="CharacterEllipsis"/>
                                                                    <TextBlock Text="{Binding Details}" FontSize="10" Foreground="#AAB4C2"
                                                                               TextTrimming="CharacterEllipsis"/>
                                                                </StackPanel>
                                                            </StackPanel>
                                                        </Button>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
                <Border Grid.Column="1" Grid.RowSpan="2" Width="1" Background="#3A414C" Margin="4,4"/>
                <Grid x:Name="ViewModeButtons" Grid.Column="2" Grid.RowSpan="2" Width="84" Height="64"
                      VerticalAlignment="Center" HorizontalAlignment="Right">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Button x:Name="ListViewButton" Grid.Row="0" Grid.Column="0" Tag="0" Click="ViewModeButton_Click"
                            Width="38" Height="28" MinWidth="0" MinHeight="0" Padding="0" Margin="0" AutomationProperties.Name="List view"
                            ToolTipService.ToolTip="List view">
                        <FontIcon Glyph="&#xE8FD;" FontSize="16"/>
                    </Button>
                    <Button x:Name="DetailsViewButton" Grid.Row="0" Grid.Column="1" Tag="1" Click="ViewModeButton_Click"
                            Width="38" Height="28" MinWidth="0" MinHeight="0" Padding="0" Margin="0" AutomationProperties.Name="Details view"
                            ToolTipService.ToolTip="Details view">
                        <FontIcon Glyph="&#xF2C7;" FontSize="16"/>
                    </Button>
                    <Button x:Name="ThumbnailsViewButton" Grid.Row="1" Grid.Column="0" Tag="2" Click="ViewModeButton_Click"
                            Width="38" Height="28" MinWidth="0" MinHeight="0" Padding="0" Margin="0" AutomationProperties.Name="Thumbnail view"
                            ToolTipService.ToolTip="Thumbnail view">
                        <FontIcon Glyph="&#xE8B9;" FontSize="16"/>
                    </Button>
                    <Button x:Name="SinglePaneButton" Grid.Row="1" Grid.Column="1" Tag="TogglePane"
                            Click="ViewModeButton_Click" Width="38" Height="28" MinWidth="0" MinHeight="0" Padding="0" Margin="0"
                            AutomationProperties.Name="Toggle single and dual panes"
                            ToolTipService.ToolTip="Toggle single / dual pane">
                        <TextBlock Text="1 | 2" FontSize="11" FontWeight="SemiBold"/>
                    </Button>
                </Grid>
            </Grid>
        </Border>

        <Border Grid.Row="2" Grid.ColumnSpan="3" Background="Transparent"
                BorderBrush="#303640" BorderThickness="0,0,0,1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Padding="4,0" Spacing="2">
                <Button Content="&#xE72B;" FontFamily="Segoe MDL2 Assets" ToolTipService.ToolTip="Back" Click="BackButton_Click"/>
                <Button Content="&#xE72A;" FontFamily="Segoe MDL2 Assets" ToolTipService.ToolTip="Forward" Click="ForwardButton_Click"/>
                <Button Content="&#xE74A;" FontFamily="Segoe MDL2 Assets" ToolTipService.ToolTip="Up" Click="UpButton_Click"/>
                <Button Content="&#xE72C;" FontFamily="Segoe MDL2 Assets" ToolTipService.ToolTip="Refresh" Click="RefreshButton_Click"/>
                <Border Width="1" Height="22" Background="#3A414C" Margin="8,0"/>
                <Border Width="1" Height="22" Background="#3A414C" Margin="4,0"/>
                <Button Content="&#xE710;" FontFamily="Segoe MDL2 Assets" ToolTipService.ToolTip="New item"
                        AutomationProperties.Name="New item" Click="NewItemButton_Click"/>
                <Button Content="&#xE713;" FontFamily="Segoe MDL2 Assets" ToolTipService.ToolTip="Settings"
                        AutomationProperties.Name="Settings" Click="SettingsButton_Click"/>
            </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Right"
                            Padding="4,0" Spacing="2">
                    <TextBox x:Name="SearchBox" Width="260" Height="28"
                             TextChanged="SearchBox_TextChanged"
                             PlaceholderText="Filter current tab" AutomationProperties.Name="Filter current tab"/>
                </StackPanel>
            </Grid>
        </Border>

        <Border x:Name="Sidebar" Grid.Row="3" Grid.Column="0" Background="Transparent"
                BorderBrush="#303640" BorderThickness="0,0,1,0">
            <Grid Padding="10">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <TextBlock Text="QUICK ACCESS" FontSize="11" FontWeight="Bold" Foreground="#AAB4C2" Margin="8,6,0,8"/>
                <ListView x:Name="QuickAccessList" Grid.Row="1" SelectionMode="None" IsItemClickEnabled="True"
                          ItemClick="QuickAccessList_ItemClick" RightTapped="QuickAccessList_RightTapped" MaxHeight="220">
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal" Spacing="10" Padding="4,6">
                                <FontIcon Glyph="{Binding Icon}" FontSize="15" Foreground="#8EC5FF"/>
                                <TextBlock Text="{Binding Name}" VerticalAlignment="Center"/>
                            </StackPanel>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
                <Grid Grid.Row="2" Margin="0,14,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <TextBlock Text="FOLDERS" FontSize="11" FontWeight="Bold" Foreground="#AAB4C2" Margin="8,0,0,8"/>
                    <TreeView x:Name="FolderTree" Grid.Row="1" ItemInvoked="FolderTree_ItemInvoked"
                              Expanding="FolderTree_Expanding">
                        <TreeView.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <Grid Width="18" Height="18">
                                        <FontIcon Glyph="{Binding Content.Icon}" FontSize="14" Foreground="#83BFFF"/>
                                        <Image Source="{Binding Content.IconImage}" Stretch="Uniform"/>
                                    </Grid>
                                    <TextBlock Text="{Binding Content.Name}" TextTrimming="CharacterEllipsis"/>
                                </StackPanel>
                            </DataTemplate>
                        </TreeView.ItemTemplate>
                    </TreeView>
                </Grid>
            </Grid>
        </Border>

        <Border Grid.Row="3" Grid.Column="1" Background="#303640" ToolTipService.ToolTip="Drag to resize the folder tree"
                PointerPressed="Splitter_PointerPressed" PointerMoved="Splitter_PointerMoved"
                PointerReleased="Splitter_PointerReleased" PointerCanceled="Splitter_PointerCanceled"
                PointerCaptureLost="Splitter_PointerCaptureLost" Tag="Sidebar"/>

        <Grid x:Name="PanesGrid" Grid.Row="3" Grid.Column="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="8"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Border x:Name="LeftPaneBorder" Grid.Column="0" Margin="5" BorderThickness="2"
                    BorderBrush="#4C5664" CornerRadius="5" PointerPressed="PaneBorder_PointerPressed">
              <Grid x:Name="LeftPanel" Margin="3">
                <Grid.RowDefinitions>
                    <RowDefinition Height="38"/>
                    <RowDefinition Height="36"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <Grid Grid.Row="0" Background="Transparent" DoubleTapped="TabStrip_DoubleTapped" Tag="Left">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel x:Name="LeftTabs" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center"/>
                    <Button Grid.Column="1" Content="&#xE700;" FontFamily="Segoe MDL2 Assets"
                            ToolTipService.ToolTip="Folder options" AutomationProperties.Name="Folder options"
                            Tag="Left" Click="FolderPanelMenu_Click"/>
                </Grid>
                <Grid x:Name="LeftAddressArea" Grid.Row="1" ColumnSpacing="4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="32"/>
                    </Grid.ColumnDefinitions>
                    <ScrollViewer x:Name="LeftBreadcrumbScroller" VerticalScrollBarVisibility="Disabled"
                                  HorizontalScrollBarVisibility="Auto" VerticalAlignment="Center">
                        <StackPanel x:Name="LeftBreadcrumbSegments" Orientation="Horizontal" Spacing="2"/>
                    </ScrollViewer>
                    <AutoSuggestBox x:Name="LeftAddress" Grid.Column="0" Height="32" PlaceholderText="Enter path"
                                    QuerySubmitted="Address_QuerySubmitted" TextChanged="Address_TextChanged"
                                    Visibility="Collapsed" AutomationProperties.Name="Left pane path"/>
                    <Button x:Name="LeftAddressButton" Grid.Column="1" Content="&#xE70F;" FontFamily="Segoe MDL2 Assets"
                            Click="AddressEdit_Click" Tag="Left" ToolTipService.ToolTip="Edit path"
                            AutomationProperties.Name="Edit left pane path"/>
                </Grid>
                <ListView x:Name="LeftList" Grid.Row="2" SelectionMode="Multiple" IsItemClickEnabled="True"
                          ItemClick="LeftList_ItemClick" DoubleTapped="LeftList_DoubleTapped"
                          SelectionChanged="ExplorerList_SelectionChanged"
                          PointerPressed="ExplorerList_PointerPressed" PointerWheelChanged="ExplorerList_PointerWheelChanged"
                          ContainerContentChanging="LeftList_ContainerContentChanging"
                          RightTapped="ExplorerList_RightTapped" KeyDown="ExplorerList_KeyDown"
                          ItemsSource="{x:Bind LeftEntries}"/>
              </Grid>
            </Border>
            <Button x:Name="LeftRestoreButton" Grid.Column="0" Content="+" Visibility="Collapsed"
                    AutomationProperties.Name="Show left pane" ToolTipService.ToolTip="Restore dual-pane view"
                    Click="RestorePaneButton_Click" Tag="Left"/>
            <Border x:Name="PaneSplitter" Grid.Column="1" Background="#303640" ToolTipService.ToolTip="Drag to resize the directory panels"
                    PointerPressed="Splitter_PointerPressed" PointerMoved="Splitter_PointerMoved"
                    PointerReleased="Splitter_PointerReleased" PointerCanceled="Splitter_PointerCanceled"
                    PointerCaptureLost="Splitter_PointerCaptureLost" Tag="Panes"/>
            <Border x:Name="RightPaneBorder" Grid.Column="2" Margin="5" BorderThickness="2"
                    BorderBrush="#4C5664" CornerRadius="5" PointerPressed="PaneBorder_PointerPressed">
              <Grid x:Name="RightPanel" Margin="3">
                <Grid.RowDefinitions>
                    <RowDefinition Height="38"/>
                    <RowDefinition Height="36"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <Grid Grid.Row="0" Background="Transparent" DoubleTapped="TabStrip_DoubleTapped" Tag="Right">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel x:Name="RightTabs" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center"/>
                    <Button Grid.Column="1" Content="&#xE700;" FontFamily="Segoe MDL2 Assets"
                            ToolTipService.ToolTip="Folder options" AutomationProperties.Name="Folder options"
                            Tag="Right" Click="FolderPanelMenu_Click"/>
                </Grid>
                <Grid x:Name="RightAddressArea" Grid.Row="1" ColumnSpacing="4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="32"/>
                    </Grid.ColumnDefinitions>
                    <ScrollViewer x:Name="RightBreadcrumbScroller" VerticalScrollBarVisibility="Disabled"
                                  HorizontalScrollBarVisibility="Auto" VerticalAlignment="Center">
                        <StackPanel x:Name="RightBreadcrumbSegments" Orientation="Horizontal" Spacing="2"/>
                    </ScrollViewer>
                    <AutoSuggestBox x:Name="RightAddress" Grid.Column="0" Height="32" PlaceholderText="Enter path"
                                    QuerySubmitted="Address_QuerySubmitted" TextChanged="Address_TextChanged"
                                    Visibility="Collapsed" AutomationProperties.Name="Right pane path"/>
                    <Button x:Name="RightAddressButton" Grid.Column="1" Content="&#xE70F;" FontFamily="Segoe MDL2 Assets"
                            Click="AddressEdit_Click" Tag="Right" ToolTipService.ToolTip="Edit path"
                            AutomationProperties.Name="Edit right pane path"/>
                </Grid>
                <ListView x:Name="RightList" Grid.Row="2" SelectionMode="Multiple" IsItemClickEnabled="True"
                          ItemClick="RightList_ItemClick" DoubleTapped="RightList_DoubleTapped"
                          SelectionChanged="ExplorerList_SelectionChanged"
                          PointerPressed="ExplorerList_PointerPressed" PointerWheelChanged="ExplorerList_PointerWheelChanged"
                          ContainerContentChanging="RightList_ContainerContentChanging"
                          RightTapped="ExplorerList_RightTapped" KeyDown="ExplorerList_KeyDown"
                          ItemsSource="{x:Bind RightEntries}"/>
              </Grid>
            </Border>
            <Button x:Name="RightRestoreButton" Grid.Column="2" Content="+" Visibility="Collapsed"
                    AutomationProperties.Name="Show right pane" ToolTipService.ToolTip="Restore dual-pane view"
                    Click="RestorePaneButton_Click" Tag="Right"/>
        </Grid>

        <Border Grid.Row="4" Grid.ColumnSpan="3" Background="Transparent"
                BorderBrush="#303640" BorderThickness="0,1,0,0">
            <Grid Padding="12,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="StatusText" Text="Ready" FontSize="11" Foreground="#AAB4C2"
                           VerticalAlignment="Center"/>
                <StackPanel x:Name="ThumbnailSizePanel" Grid.Column="1" Orientation="Horizontal" Spacing="6"
                            VerticalAlignment="Center" Visibility="Collapsed">
                    <TextBlock Text="Thumbnail size" FontSize="10" Foreground="#AAB4C2"
                               VerticalAlignment="Center"/>
                    <Slider x:Name="IconSizeSlider" Width="150" Height="24" Minimum="64" Maximum="512" Value="120"
                            StepFrequency="16" ValueChanged="IconSizeSlider_ValueChanged"
                            AutomationProperties.Name="Thumbnail size"/>
                    <TextBlock x:Name="IconSizeText" Width="40" FontSize="10" Foreground="#AAB4C2"
                               VerticalAlignment="Center"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
